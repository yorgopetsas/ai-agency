# LLM providers (llm.py router reads these)
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# Images (optional)
PEXELS_API_KEY=your_key_here

# Telegram bot (send_message.py, test_telegram.py)
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Social Media - Moltbook (AI agent social network)
# Get API key: POST https://www.moltbook.com/api/v1/agents/register
MOLTBOOK_API_KEY=moltbook_your_key_here

# Social Media - Bluesky (AT Protocol)
# Create app password: Settings > Advanced > App Passwords
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here

# Social Media - Mastodon (federated social network)
# Create application: https://mastodon.social/settings/applications
MASTODON_ACCESS_TOKEN=your_token_here
MASTODON_API_BASE=https://mastodon.social

# Social Media - Reddit (OAuth)
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=AIAgencyBot/1.0
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password
